{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "accounts-route": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "transactions-route": {
        "ClusterId": "transactions",
        "Match": {
          "Path": "/transactions/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/transactions" }
        ]
      }
    },
    "Clusters": {
      "accounts": {
        "Destinations": {
          "d1": { "Address": "http://accounts-api:8080/" }
        }
      },
      "transactions": {
        "Destinations": {
          "d1": { "Address": "http://transactions-api:8080/" }
        }
      }
    }
  }
}
